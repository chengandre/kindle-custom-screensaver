{
  "manifest_version": 2,
  "id": "chengandre-kindle-custom-screensaver",
  "name": "Kindle Custom Screensaver",
  "description": "Self-hosted KPM repository for Kindle Custom Screensaver.",
  "packages": {
    "custom-screensaver": {
      "name": "Kindle Custom Screensaver",
      "author": "Andre Cheng",
      "description": "Custom PNG and JPEG sleep-screen images while retaining the stock Kindle reading interface.",
      "artifacts": [
        {
          "url": "https://github.com/chengandre/kindle-custom-screensaver/releases/download/v@VERSION@/custom-screensaver_@VERSION@_kindlehf.kpkg",
          "version": [
            @VERSION_MAJOR@,
            @VERSION_MINOR@,
            @VERSION_PATCH@
          ],
          "dependencies": [],
          "supported_platforms": [
            "kindlehf"
          ]
        }
      ]
    }
  }
}
